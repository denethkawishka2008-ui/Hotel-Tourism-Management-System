<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Hospitality_and_tourism_system.Tourism_ManagementController">
    <children>
        <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Manage Tourist Attractions &amp; Email Content" />

        <VBox layoutX="30.0" layoutY="70.0" prefWidth="350.0" spacing="12.0">
            <Label style="-fx-text-fill: #94a3b8;" text="Place Name:" />
            <TextField fx:id="txtPlaceName" promptText="e.g. Sigiriya Rock Fortress" styleClass="text-input" />

            <Label style="-fx-text-fill: #94a3b8;" text="Description:" />
            <TextArea fx:id="txtDescription" prefHeight="90.0" promptText="Brief details about the place..." styleClass="text-area" />

            <Label style="-fx-text-fill: #94a3b8;" text="Google Maps Link:" />
            <TextField fx:id="txtMapUrl" promptText="https://maps.google.com/..." styleClass="text-input" />

            <Label style="-fx-text-fill: #94a3b8;" text="Place Image:" />
            <HBox spacing="10.0">
                <Button onAction="#handleChooseImage" style="-fx-background-color: #3b82f6; -fx-text-fill: white;" text="Choose Image" />
                <Label fx:id="lblImagePath" style="-fx-text-fill: #cbd5e1;" text="No image selected" wrapText="true" />
            </HBox>

            <ImageView fx:id="imgPreview" fitHeight="120.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" />

            <HBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                <Button onAction="#handleSave" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold;" text="Save / Add" />
                <Button onAction="#handleUpdate" style="-fx-background-color: #eab308; -fx-text-fill: white; -fx-font-weight: bold;" text="Update" />
                <Button onAction="#handleDelete" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;" text="Delete" />
                <Button onAction="#handleClear" style="-fx-background-color: #64748b; -fx-text-fill: white;" text="Clear" />
            </HBox>
        </VBox>

        <TableView fx:id="tblPlaces" layoutX="400.0" layoutY="70.0" prefHeight="540.0" prefWidth="470.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="140.0" text="Place Name" />
                <TableColumn fx:id="colDescription" prefWidth="180.0" text="Description" />
                <TableColumn fx:id="colMap" prefWidth="100.0" text="Map URL" />
            </columns>
        </TableView>
    </children>
</AnchorPane>