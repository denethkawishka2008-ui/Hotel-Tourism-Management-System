<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootStackPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1100.0" stylesheets="@dashbord.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Hospitality_and_tourism_system.DashbordController">
   <children>
      <AnchorPane fx:id="mainAnchorPane" prefHeight="700.0" prefWidth="1100.0" styleClass="main-content">
         <children>
            <!-- Sidebar -->
            <VBox layoutX="0.0" layoutY="0.0" prefHeight="700.0" prefWidth="280.0" spacing="10.0" styleClass="sidebar">
               <padding>
                  <Insets bottom="20.0" left="18.0" right="18.0" top="20.0" />
               </padding>
               <children>
                  <!-- Logo & Title -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <ImageView fx:id="hotelLogo" fitHeight="55.0" fitWidth="55.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@resources/hotel.png" />
                           </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Dashboard" textFill="#d4af37">
                                 <font>
                                    <Font name="System Bold" size="17.0" />
                                 </font>
                              </Label>
                              <Label text="Code-DK" textFill="#a0a0a0">
                                 <font>
                                    <Font size="11.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <VBox prefHeight="5.0" />
                  
                  <!-- Navigation Buttons -->
                  <Button fx:id="btnCustomer" onAction="#handleCustomer" alignment="BASELINE_LEFT" graphicTextGap="16.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-button" text="Customer management">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@resources/cm.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  
                  <Button fx:id="btnRoom" onAction="#handleRoom" alignment="BASELINE_LEFT" graphicTextGap="16.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-button" text="Room management">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@resources/rm.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  
                  <Button fx:id="btnRoomkeeping" onAction="#handleHousekeeping" alignment="BASELINE_LEFT" graphicTextGap="16.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-button" text="Housekeeping management">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@resources/hcm.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  
                  <Button fx:id="btnEmployee" onAction="#handleEmployee" alignment="BASELINE_LEFT" graphicTextGap="16.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-button" text="Employee management">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@resources/em.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  
                  <Button fx:id="btnHistory" onAction="#handleHistory" alignment="BASELINE_LEFT" graphicTextGap="16.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-button" text="Customer_History" />
                  
                  <VBox VBox.vgrow="ALWAYS" />
                  
                  <Button fx:id="btnTourism" onAction="#handleTourismManagement" alignment="BASELINE_LEFT" graphicTextGap="16.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-button" text="Tourism Management">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@resources/T_room.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                  <!-- Back to Login Button -->
                  <Button fx:id="btnBack" onAction="#handleBack" alignment="BASELINE_LEFT" graphicTextGap="14.0" prefHeight="38.0" prefWidth="244.0" styleClass="back-button" text="Back to Login" />

                  <!-- Admin Profile Button (Placed right below Back to Login) -->
                  <Button fx:id="btnAdminProfile" onAction="#handleOpenAdminProfile" alignment="BASELINE_LEFT" graphicTextGap="14.0" prefHeight="40.0" prefWidth="244.0" styleClass="sidebar-profile-btn" text="Admin Account &amp; Profile">
                     <graphic>
                        <ImageView fx:id="imgSidebarAvatar" fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true" styleClass="circular-avatar" />
                     </graphic>
                  </Button>
               </children>
            </VBox>
            
            <!-- Main Content Area -->
            <AnchorPane layoutX="300.0" layoutY="20.0" prefHeight="660.0" prefWidth="775.0">
               <children>
                  <!-- Hotel Banner -->
                  <AnchorPane layoutY="0.0" prefHeight="210.0" prefWidth="775.0" styleClass="hotel-banner-card">
                     <children>
                        <ImageView fitHeight="210.0" fitWidth="775.0" pickOnBounds="true" preserveRatio="false">
                           <image>
                              <Image url="@resources/hotel.png" />
                           </image>
                        </ImageView>
                     </children>
                  </AnchorPane>
                  
                  <!-- Welcome Bar -->
                  <AnchorPane layoutY="225.0" prefHeight="55.0" prefWidth="775.0" styleClass="welcome-card">
                     <padding>
                        <Insets left="20.0" right="20.0" />
                     </padding>
                     <children>
                        <VBox layoutX="15.0" layoutY="9.0">
                           <children>
                              <Label text="Welcome to Code-DK Hotel" textFill="#d4af37">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Manage your guests, rooms, and tours seamlessly." textFill="#a0a0a0">
                                 <font>
                                    <Font size="11.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        
                        <!-- Live Time -->
                        <Label fx:id="lblTime" layoutX="470.0" layoutY="18.0" text="2026-10-10 | 00:00:00" textFill="#ffffff">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>

                        <!-- Notification Button (Employees' Messages) -->
                        <Button fx:id="btnNotifications" layoutX="710.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleOpenNotifications" prefHeight="35.0" prefWidth="45.0" styleClass="icon-btn" text="🔔" />
                     </children>
                  </AnchorPane>
                  
                  <!-- Status Cards HBox -->
                  <HBox layoutY="295.0" spacing="15.0">
                     <children>
                        <!-- Available Rooms Card -->
                        <AnchorPane prefHeight="125.0" prefWidth="248.0" styleClass="status-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" layoutX="12.0" layoutY="12.0" prefHeight="100.0" prefWidth="224.0" spacing="12.0">
                                 <children>
                                    <VBox alignment="CENTER_LEFT" prefWidth="120.0" spacing="8.0">
                                       <children>
                                          <Label text="Available Rooms" textFill="#d4af37" wrapText="true">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="lblAvailableRooms" text="1" textFill="#ffffff">
                                             <font>
                                                <Font name="System Bold" size="28.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <ImageView fitHeight="75.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@resources/A_room.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                        
                        <!-- Booked Rooms Card -->
                        <AnchorPane prefHeight="125.0" prefWidth="248.0" styleClass="status-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" layoutX="12.0" layoutY="12.0" prefHeight="100.0" prefWidth="224.0" spacing="12.0">
                                 <children>
                                    <VBox alignment="CENTER_LEFT" prefWidth="120.0" spacing="8.0">
                                       <children>
                                          <Label text="Booked Rooms" textFill="#d4af37" wrapText="true">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="lblBookedRooms" text="1" textFill="#ffffff">
                                             <font>
                                                <Font name="System Bold" size="28.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <ImageView fitHeight="75.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@resources/B_room.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                        
                        <!-- Total Customers Today Card -->
                        <AnchorPane prefHeight="125.0" prefWidth="248.0" styleClass="status-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" layoutX="12.0" layoutY="12.0" prefHeight="100.0" prefWidth="224.0" spacing="12.0">
                                 <children>
                                    <VBox alignment="CENTER_LEFT" prefWidth="120.0" spacing="8.0">
                                       <children>
                                          <Label text="Total Customers Today" textFill="#d4af37" wrapText="true">
                                             <font>
                                                <Font name="System Bold" size="11.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="lblTotalCustomers" text="3" textFill="#ffffff">
                                             <font>
                                                <Font name="System Bold" size="28.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <ImageView fitHeight="75.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@resources/T_room.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>

      <!-- CUSTOM PROFILE MODAL POPUP -->
      <AnchorPane fx:id="paneProfileModal" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="620.0" prefWidth="480.0" styleClass="modal-pane" visible="false">
         <children>
            <VBox alignment="TOP_CENTER" layoutX="30.0" layoutY="20.0" prefHeight="580.0" prefWidth="420.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="👤 Admin Account &amp; Profile" textFill="#38bdf8">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <VBox HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCloseProfile" mnemonicParsing="false" onAction="#handleCloseProfileModal" styleClass="btn-danger" text=" ✕ " />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <ImageView fx:id="imgModalAvatar" fitHeight="65.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true" styleClass="circular-avatar" />
                        <Button fx:id="btnUploadImage" mnemonicParsing="false" onAction="#handleUploadProfileImage" prefHeight="35.0" prefWidth="180.0" styleClass="btn-action" text="📷 Upload Picture" />
                     </children>
                  </HBox>

                  <TextField fx:id="txtProfileEmpId" editable="false" promptText="Admin ID" />
                  <TextField fx:id="txtProfileName" promptText="Full Name" />
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtProfileNic" prefHeight="35.0" prefWidth="200.0" promptText="NIC" />
                        <TextField fx:id="txtProfilePhone" prefHeight="35.0" prefWidth="210.0" promptText="Phone Number" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtProfileEmail" promptText="Email Address" />
                  <TextField fx:id="txtProfileAddress" promptText="Home Address" />
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtProfileUsername" prefHeight="35.0" prefWidth="200.0" promptText="Username" />
                        <PasswordField fx:id="txtProfilePassword" prefHeight="35.0" prefWidth="210.0" promptText="Password" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 5 0 0 0;">
                     <children>
                        <Button fx:id="btnSaveProfile" mnemonicParsing="false" onAction="#handleSaveProfile" prefHeight="40.0" prefWidth="180.0" styleClass="btn-success" text="Save Changes" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </AnchorPane>

      <!-- CUSTOM NOTIFICATIONS MODAL POPUP -->
      <AnchorPane fx:id="paneNotificationModal" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="480.0" prefWidth="460.0" styleClass="modal-pane" visible="false">
         <children>
            <VBox layoutX="25.0" layoutY="20.0" prefHeight="440.0" prefWidth="410.0" spacing="12.0">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="🔔 Employee Notifications" textFill="#38bdf8">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <VBox HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleCloseNotificationModal" styleClass="btn-danger" text=" ✕ " />
                     </children>
                  </HBox>
                  <TextArea fx:id="txtNotificationArea" editable="false" prefHeight="350.0" prefWidth="410.0" promptText="Loading messages..." wrapText="true" />
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>