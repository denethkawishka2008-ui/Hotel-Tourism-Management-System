<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1150.0" stylesheets="@customer_history.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Hospitality_and_tourism_system.CustomerHistoryController">
   <children>
      <VBox layoutX="25.0" layoutY="20.0" prefHeight="710.0" prefWidth="1100.0" spacing="15.0">
         <children>
            <!-- Top Header & Back Button -->
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="1100.0">
               <children>
                  <Label styleClass="header-label" text="Customer Visit History" />
                  <VBox HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnBack" mnemonicParsing="false" styleClass="back-button" text="&lt; Back to Dashboard" />
               </children>
            </HBox>
            
            <!-- Summary Cards HBox -->
            <HBox spacing="20.0">
               <children>
                  <AnchorPane prefHeight="90.0" prefWidth="350.0" styleClass="card">
                     <children>
                        <VBox layoutX="20.0" layoutY="15.0" spacing="5.0">
                           <children>
                              <Label styleClass="card-title" text="Total Visitors (This Year 2026)" />
                              <Label fx:id="lblYearVisitors" styleClass="card-value" text="0" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
                  
                  <AnchorPane prefHeight="90.0" prefWidth="350.0" styleClass="card">
                     <children>
                        <VBox layoutX="20.0" layoutY="15.0" spacing="5.0">
                           <children>
                              <Label styleClass="card-title" text="Total Revenue / Profit (This Year)" />
                              <Label fx:id="lblYearRevenue" styleClass="card-value" text="Rs. 0.00" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
                  
                  <AnchorPane prefHeight="90.0" prefWidth="360.0" styleClass="card">
                     <children>
                        <VBox layoutX="20.0" layoutY="15.0" spacing="5.0">
                           <children>
                              <Label styleClass="card-title" text="Selected Customer Visits (NIC Check)" />
                              <Label fx:id="lblNicVisitCount" styleClass="card-value" text="Select a row / Search NIC" textFill="#d4af37">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
               </children>
            </HBox>
            
            <!-- Search, Filter & Print Report Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="240.0" promptText="Search by NIC or Name..." />
                  <Button fx:id="btnSearch" mnemonicParsing="false" prefHeight="38.0" prefWidth="80.0" styleClass="search-button" text="Search" />
                  
                  <DatePicker fx:id="datePicker" prefHeight="38.0" prefWidth="150.0" promptText="Filter by Date" />
                  <Button fx:id="btnDateFilter" mnemonicParsing="false" prefHeight="38.0" prefWidth="85.0" styleClass="secondary-button" text="Filter Date" />
                  
                  <Button fx:id="btnToday" mnemonicParsing="false" prefHeight="38.0" prefWidth="105.0" styleClass="secondary-button" text="Today's History" />
                  
                  <Button fx:id="btnReset" mnemonicParsing="false" prefHeight="38.0" prefWidth="75.0" styleClass="secondary-button" text="Reset" />

                  <!-- Report Print Button Added Here -->
                  <Button fx:id="btnPrintReport" mnemonicParsing="false" onAction="#handlePrintReport" prefHeight="38.0" prefWidth="120.0" styleClass="search-button" text="🖨 Print Report" />
               </children>
            </HBox>
            
            <!-- History TableView -->
            <TableView fx:id="tableHistory" prefHeight="430.0" prefWidth="1100.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNic" prefWidth="130.0" text="Customer NIC" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="First Name" />
                <TableColumn fx:id="colLastName" prefWidth="120.0" text="Last Name" />
                <TableColumn fx:id="colRoomType" prefWidth="100.0" text="Room Type" />
                <TableColumn fx:id="colRoomNo" prefWidth="90.0" text="Room No" />
                <TableColumn fx:id="colInDate" prefWidth="100.0" text="In Date" />
                <TableColumn fx:id="colOutDate" prefWidth="100.0" text="Out Date" />
                <TableColumn fx:id="colAmount" prefWidth="115.0" text="Total Amount" />
                <TableColumn fx:id="colPayment" prefWidth="140.0" text="Payment Method" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>